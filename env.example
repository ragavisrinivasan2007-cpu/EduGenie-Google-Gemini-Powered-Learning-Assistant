# Copy this file to .env

# Real Gemini API key. Keep this server-side only.
GEMINI_API_KEY=

# Current default model used by the project.
GEMINI_MODEL=gemini-3.8-flash

# false = real Gemini; true = deterministic local demo responses.
DEMO_MODE=false

# Browser origins allowed to call this backend.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
